# Copy to .env (gitignored) and fill in. Required before `docker compose up`.
#
# Compose reads this file for interpolation AND for COMPOSE_FILE, so
# `docker compose up -d` starts the platform stack plus the overlay.

COMPOSE_FILE=compose.yaml:compose.forwarders.yaml

# Shared UI login password (no username).
UI_PASSWORD=change-me

# HMAC key for the session cookie. Generate with:
#   openssl rand -hex 32
UI_SESSION_SECRET=replace-with-a-long-random-string

# Public hostname. A record must point at this host.
DOMAIN=forwarder.skilphi.com

# Optional Let's Encrypt expiry notices. Caddy obtains certs either way.
ACME_EMAIL=

# Absolute path of this repository on the host. The API container bind-mounts
# this path at the same location so `docker compose` resolves ./bin and
# ./secrets to real host paths via the mounted docker socket.
LAPOSTE_PROJECT_DIR=/absolute/path/to/laposte_forwarder

# Set false only for local HTTP (Vite). Production behind Caddy is HTTPS.
COOKIE_SECURE=true

# Pinned imapsync image used when the API creates a forwarder.
IMAPSYNC_IMAGE=gilleslamiral/imapsync:2.319@sha256:161336e1a6db587bc42ea1126cfc9b6afa67ea92b408ea4c4454f7f771561aa4
