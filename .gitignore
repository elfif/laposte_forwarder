# Per-account overlay: written by the API, contains addresses.
compose.forwarders.yaml
docker-compose.yaml
docker-compose.yml

# Credentials. Never commit anything in here except the .gitkeep placeholder.
secrets/*
!secrets/.gitkeep

# Env files, in case any are ever created locally.
*.env
!*.env.example

# Per-run stats JSONL (directory placeholder is kept).
data/stats/*
!data/stats/.gitkeep

# Node / Vite build output.
api/node_modules/
api/dist/
web/node_modules/
web/dist/
